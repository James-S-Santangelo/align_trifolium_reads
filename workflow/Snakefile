# ──────────────────────────────────────────────────────────────────────────────
# Resource helpers
# ──────────────────────────────────────────────────────────────────────────────

def res(wildcards, key):
    return config["resources"][COV_CAT[wildcards.sample]][key]

# ──────────────────────────────────────────────────────────────────────────────
# Derived target lists
# List comprehensions (not expand) where project is sample-specific.
# ──────────────────────────────────────────────────────────────────────────────

MARKDUP_BAMS = [
    f"{OUTDIR}/{PROJECT[s]}/markdup/{s}.markdup.bam"
    for s in SAMPLES
]
FLAGSTATS = [
    f"{OUTDIR}/{PROJECT[s]}/qc/flagstat/{s}.flagstat"
    for s in SAMPLES
]
MOSDEPTHS = [
    f"{OUTDIR}/{PROJECT[s]}/qc/mosdepth/{s}.mosdepth.summary.txt"
    for s in SAMPLES
]
FASTQC_DONE = [
    f"{OUTDIR}/{PROJECT[s]}/qc/fastqc/{s}_lane{lane}_R{read}_fastqc.zip"
    for s    in SAMPLES
    for lane in SAMPLE_LANES[s]
    for read in ["1", "2"]
]

# Projects present in the sample sheet
PROJECTS = sorted(set(PROJECT.values()))

# One MultiQC report per project
MULTIQC_REPORTS = [
    f"{OUTDIR}/{p}/qc/multiqc/multiqc_report.html"
    for p in PROJECTS
]

# ──────────────────────────────────────────────────────────────────────────────
# Local rules — run on the head node, not submitted to the cluster scheduler.
# Appropriate for steps that are fast enough not to need dedicated compute nodes.
# Note: mosdepth is included here because --fast-mode makes it lightweight;
# check your institution's head-node CPU/memory policies if sample counts are
# very large.
# ──────────────────────────────────────────────────────────────────────────────

localrules: all, flagstat, mosdepth

# ──────────────────────────────────────────────────────────────────────────────
# all
# ──────────────────────────────────────────────────────────────────────────────

rule all:
    input:
        MARKDUP_BAMS,
        FLAGSTATS,
        MOSDEPTHS,
        FASTQC_DONE,
        MULTIQC_REPORTS

# ──────────────────────────────────────────────────────────────────────────────
# Rule 1: fastp — adapter trimming per lane
# ──────────────────────────────────────────────────────────────────────────────

rule fastp:
    input:
        r1 = lambda wc: SAMPLE_R1[wc.sample][int(wc.lane)],
        r2 = lambda wc: SAMPLE_R2[wc.sample][int(wc.lane)],
    output:
        r1   = temp(f"{OUTDIR}/tmp/trimmed/{{project}}/{{sample}}_lane{{lane}}_R1.fastq.gz"),
        r2   = temp(f"{OUTDIR}/tmp/trimmed/{{project}}/{{sample}}_lane{{lane}}_R2.fastq.gz"),
        json = f"{OUTDIR}/{{project}}/qc/fastp/{{sample}}_lane{{lane}}.json",
        html = f"{OUTDIR}/{{project}}/qc/fastp/{{sample}}_lane{{lane}}.html",
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/fastp/{{project}}/{{sample}}_lane{{lane}}.log",
    threads: 2
    resources:
        mem_mb  = 5000,
        runtime = lane_rt(15, 3) 
    params:
        min_length = 36,
        quality    = 20
    shell:
        """
        fastp \
            -i {input.r1} -I {input.r2} \
            -o {output.r1} -O {output.r2} \
            --json {output.json} --html {output.html} \
            --length_required {params.min_length} \
            --qualified_quality_phred {params.quality} \
            --detect_adapter_for_pe \
            --thread {threads} \
            2> {log}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Rule 2: FastQC on trimmed reads (per lane)
# ──────────────────────────────────────────────────────────────────────────────

rule fastqc:
    input:
        r1 = rules.fastp.output.r1,
        r2 = rules.fastp.output.r2,
    output:
        zip_r1  = f"{OUTDIR}/{{project}}/qc/fastqc/{{sample}}_lane{{lane}}_R1_fastqc.zip",
        zip_r2  = f"{OUTDIR}/{{project}}/qc/fastqc/{{sample}}_lane{{lane}}_R2_fastqc.zip",
        html_r1 = f"{OUTDIR}/{{project}}/qc/fastqc/{{sample}}_lane{{lane}}_R1_fastqc.html",
        html_r2 = f"{OUTDIR}/{{project}}/qc/fastqc/{{sample}}_lane{{lane}}_R2_fastqc.html",
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/fastqc/{{project}}/{{sample}}_lane{{lane}}.log",
    params:
        outdir = f"{OUTDIR}/{{project}}/qc/fastqc",
    threads: 2
    resources:
        mem_mb  = 2500,
        runtime = lane_rt(15, 3)
    shell:
        "fastqc --threads {threads} --outdir {params.outdir} {input.r1} {input.r2} 2> {log}"

# ──────────────────────────────────────────────────────────────────────────────
# Rule 3: bwa mem — align per lane, output unsorted BAM
# ──────────────────────────────────────────────────────────────────────────────

rule bwa_mem:
    input:
        r1 = rules.fastp.output.r1,
        r2 = rules.fastp.output.r2,
        ref = REF,
    output:
        bam = temp(f"{OUTDIR}/tmp/aligned/{{project}}/{{sample}}_lane{{lane}}.bam"),
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/bwa_mem/{{project}}/{{sample}}_lane{{lane}}.log",
    threads: lambda wc: res(wc, "threads_bwa")
    group: "align_{sample}_{lane}"
    resources:
        mem_mb  = lambda wc, threads: threads * 2000,
        runtime = lane_rt(30, 45),
        tmpdir  = config["tmpdir"]
    params:
        rg = lambda wc: (
            f"@RG\\tID:{wc.sample}_lane{wc.lane}"
            f"\\tSM:{wc.sample}"
            f"\\tLB:{wc.sample}"
            f"\\tPL:ILLUMINA"
            f"\\tPU:{wc.sample}_lane{wc.lane}"
        ),
    shell:
        """
        ( bwa mem -t {threads} -Y -K 100000000 -R '{params.rg}' \
            {input.ref} {input.r1} {input.r2} | \
            samtools view -hb -o {output.bam} - ) 2> {log}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Rule 4: sambamba sort — coordinate-sort per-lane BAM
# ──────────────────────────────────────────────────────────────────────────────

rule sort_bam:
    input:
        bam = rules.bwa_mem.output,
    output:
        bam = temp(f"{OUTDIR}/tmp/sorted/{{project}}/{{sample}}_lane{{lane}}.sorted.bam"),
        bai = temp(f"{OUTDIR}/tmp/sorted/{{project}}/{{sample}}_lane{{lane}}.sorted.bam.bai"),
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/sort_bam/{{project}}/{{sample}}_lane{{lane}}.log",
    threads: lambda wc: res(wc, "threads_sort")
    group: "align_{sample}_{lane}"
    resources:
        mem_mb  = lambda wc, threads: threads * 4000,
        runtime = lambda wc, attempt: attempt * 120,
        tmpdir  = config["tmpdir"]
    shell:
        """
        ( sambamba sort \
            -t {threads} \
            -m {resources.mem_mb}M \
            --tmpdir {resources.tmpdir}/{wildcards.sample}_lane{wildcards.lane} \
            -o {output.bam} {input.bam} ) 2> {log}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Rule 4: GATK MarkDuplicates
# ──────────────────────────────────────────────────────────────────────────────

def get_lane_bams(wildcards):
    return expand(
        rules.sort_bam.output.bam,
        project=PROJECT[wildcards.sample],
        sample=wildcards.sample,
        lane=SAMPLE_LANES[wildcards.sample],
    )

rule mark_duplicates:
    input:
        bams = get_lane_bams
    output:
        bam     = f"{OUTDIR}/{{project}}/markdup/{{sample}}.markdup.bam",
        bai     = f"{OUTDIR}/{{project}}/markdup/{{sample}}.markdup.bam.bai",
        metrics = f"{OUTDIR}/{{project}}/markdup/{{sample}}.markdup.metrics.txt",
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/mark_duplicates/{{project}}/{{sample}}.log",
    threads: 2
    resources:
        mem_mb  = lambda wc, attempt: attempt * (16000 if SAMPLE_GB[wc.sample] > 15 else 8000),
        runtime = lambda wc, attempt: attempt * math.ceil(30 + 4 * SAMPLE_GB[wc.sample]),
        tmpdir  = config["tmpdir"],
    params:
        optical_dist = 2500,
        java_opts = lambda wc, resources: f"-Xmx{resources.mem_mb - 2000}m",
        inputs    = lambda wc, input: " ".join(f"-I {b}" for b in input.bams),
    shell:
        """
        gatk --java-options "{params.java_opts}" MarkDuplicates \
            {params.inputs} \
            -O {output.bam} \
            -M {output.metrics} \
            --OPTICAL_DUPLICATE_PIXEL_DISTANCE {params.optical_dist} \
            --TMP_DIR {resources.tmpdir} \
            --VALIDATION_STRINGENCY SILENT \
            2> {log}
        samtools index -@ {threads} {output.bam}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Rule 5: samtools flagstat — per sample, localrule
# ──────────────────────────────────────────────────────────────────────────────

rule flagstat:
    input:
        bam = lambda wc: f"{OUTDIR}/{PROJECT[wc.sample]}/markdup/{wc.sample}.markdup.bam",
    output:
        f"{OUTDIR}/{{project}}/qc/flagstat/{{sample}}.flagstat",
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/flagstat/{{project}}/{{sample}}.log",
    shell:
        "samtools flagstat {input.bam} > {output} 2> {log}"

# ──────────────────────────────────────────────────────────────────────────────
# Rule 6: mosdepth — per sample, localrule
# ──────────────────────────────────────────────────────────────────────────────

rule mosdepth:
    input:
        bam = lambda wc: f"{OUTDIR}/{PROJECT[wc.sample]}/markdup/{wc.sample}.markdup.bam",
        bai = lambda wc: f"{OUTDIR}/{PROJECT[wc.sample]}/markdup/{wc.sample}.markdup.bam.bai",
    output:
        summary = f"{OUTDIR}/{{project}}/qc/mosdepth/{{sample}}.mosdepth.summary.txt",
        dist    = f"{OUTDIR}/{{project}}/qc/mosdepth/{{sample}}.mosdepth.global.dist.txt",
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/mosdepth/{{project}}/{{sample}}.log",
    params:
        prefix   = f"{OUTDIR}/{{project}}/qc/mosdepth/{{sample}}",
        quantize = "0:1:5:10:20:50:",
        min_mapq = 1,
    shell:
        """
        mosdepth \
            --fast-mode \
            --quantize {params.quantize} \
            --mapq {params.min_mapq} \
            {params.prefix} {input.bam} \
            2> {log}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Rule 7: MultiQC — combined report across all projects
# ──────────────────────────────────────────────────────────────────────────────

def multiqc_inputs(wildcards):
    """Collect QC files for a single project."""
    proj = wildcards.project
    inputs = []
    for s in (s for s in SAMPLES if PROJECT[s] == proj):
        for lane in SAMPLE_LANES[s]:
            inputs.append(f"{OUTDIR}/{proj}/qc/fastp/{s}_lane{lane}.json")
            for read in ["1", "2"]:
                inputs.append(
                    f"{OUTDIR}/{proj}/qc/fastqc/{s}_lane{lane}_R{read}_fastqc.zip"
                )
        inputs.append(f"{OUTDIR}/{proj}/qc/flagstat/{s}.flagstat")
        inputs.append(f"{OUTDIR}/{proj}/qc/mosdepth/{s}.mosdepth.summary.txt")
        inputs.append(f"{OUTDIR}/{proj}/markdup/{s}.markdup.metrics.txt")
    return inputs


rule multiqc:
    input:
        multiqc_inputs,
    output:
        report = f"{OUTDIR}/{{project}}/qc/multiqc/multiqc_report.html",
        data   = directory(f"{OUTDIR}/{{project}}/qc/multiqc/multiqc_data"),
    conda: "envs/env.yaml"
    log:
        f"{OUTDIR}/logs/multiqc/{{project}}.log",
    threads: 1
    resources:
        mem_mb = lambda wc, attempt: attempt * 16000,
        runtime = lambda wc, attempt: attempt * 360,
    params:
        outdir    = f"{OUTDIR}/{{project}}/qc/multiqc",
        file_list = f"{OUTDIR}/{{project}}/qc/multiqc/multiqc_filelist.txt",
    shell:
        """
        mkdir -p {params.outdir}
        printf "%s\n" {input} > {params.file_list}
        multiqc --force --outdir {params.outdir} --file-list {params.file_list} 2> {log}
        """

