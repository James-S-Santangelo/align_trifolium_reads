"""
Clover alignment pipeline
=========================
fastp → bwa mem (per lane) → samtools sort → merge lanes → GATK MarkDuplicates
QC: FastQC (trimmed), flagstat, mosdepth, MultiQC

Notes on temp files
-------------------
Per-lane sorted BAMs are marked temp() but run with --notemp until no further
sequencing is planned for a sample. Adding a new lane for a sample that has
already been processed will require re-running fastp + bwa_mem for all lanes
of that sample (because the temp lane BAMs will have been deleted), followed
by mark_duplicates, which takes all lanes as input.

Output structure
----------------
Permanent outputs go under {outdir}/{initial_project}/.
Temp intermediates (trimmed FASTQs, lane BAMs, merged BAMs) are flat under
{outdir}/tmp/ — no project subdir since they are deleted after use.
"""

import os
import re
import math
import pandas as pd
from snakemake.utils import min_version

min_version("9.21.0")

# ──────────────────────────────────────────────────────────────────────────────
# Configuration
# ──────────────────────────────────────────────────────────────────────────────

configfile: "../config/server.yaml"

OUTDIR    = config["results_prefix"]
REF       = config["reference"]
FASTQ_DIR = config["fastq_dir"]

# ──────────────────────────────────────────────────────────────────────────────
# Sample table
# ──────────────────────────────────────────────────────────────────────────────

samples_df = pd.read_csv(config["samples_file"], sep="\t")
samples_df = samples_df.set_index("sample")

SAMPLES = samples_df.index.tolist()
COV_CAT = samples_df["cov_cat"].to_dict()           # {sample: "high" | "low"}
PROJECT = samples_df["initial_project"].to_dict()   # {sample: project_name}

# ──────────────────────────────────────────────────────────────────────────────
# Wildcard constraints
# ──────────────────────────────────────────────────────────────────────────────

wildcard_constraints:
    sample  = "|".join(re.escape(s) for s in SAMPLES),
    project = "|".join(re.escape(p) for p in set(PROJECT.values())),
    lane    = r"\d+",

# ──────────────────────────────────────────────────────────────────────────────
# FASTQ discovery via fast recursive scandir
# ──────────────────────────────────────────────────────────────────────────────

def run_fast_scandir(dir, sample):
    """
    Recursively scan `dir` for files whose names start with `{sample}_`.
    Uses os.scandir — substantially faster than glob on large directory trees.
    """
    subfolders, files = [], []
    for f in os.scandir(dir):
        if f.is_dir():
            subfolders.append(f.path)
        if f.is_file():
            if re.match(r'^{}_'.format(re.escape(sample)), f.name):
                files.append(f.path)
    for subdir in list(subfolders):
        sf, f = run_fast_scandir(subdir, sample)
        subfolders.extend(sf)
        files.extend(f)
    return subfolders, sorted(files)


def split_r1_r2(files):
    """
    Split a flat file list into R1/R2 lists.

    Handles two naming conventions:
      1. Illumina standard: {sample}_S###_L###_R1_001.fastq.gz
         Matched by: _R1_ or _R2_ anywhere in the filename.
      2. BGI/custom: {sample}_{barcode}_{flowcell}_{lane}_1.fq.gz
         Matched by: _1.fq.gz or _2.fq.gz at end of filename ($ anchor
         prevents false matches on sample name components like lc_1_ or
         Thessa_2_ that contain _1_ / _2_ mid-string).

    Both .fq.gz and .fastq.gz extensions are handled via f(ast)?q.gz.
    """
    fq = [f for f in files if re.search(r'\.f(ast)?q\.gz$|\.f(ast)?q$', f)]
    r1 = sorted(f for f in fq if re.search(r'_R1[_.]|_1\.f(ast)?q(\.gz)?$', f))
    r2 = sorted(f for f in fq if re.search(r'_R2[_.]|_2\.f(ast)?q(\.gz)?$', f))
    return r1, r2


def discover_sample_fastqs(sample):
    _, files = run_fast_scandir(FASTQ_DIR, sample)
    r1, r2   = split_r1_r2(files)
    if not r1:
        raise ValueError(f"No R1 FASTQs found for '{sample}' under '{FASTQ_DIR}'")
    if len(r1) != len(r2):
        raise ValueError(
            f"Sample '{sample}': {len(r1)} R1 files but {len(r2)} R2 files.\n"
            f"  R1: {r1}\n  R2: {r2}"
        )
    return r1, r2


# Build sample → R1s, R2s, lanes at startup (runs once)
SAMPLE_R1    = {}
SAMPLE_R2    = {}
SAMPLE_LANES = {}

for s in SAMPLES:
    r1s, r2s = discover_sample_fastqs(s)
    SAMPLE_R1[s]    = r1s
    SAMPLE_R2[s]    = r2s
    SAMPLE_LANES[s] = [str(i) for i in range(len(r1s))]

# Use raw FASTQ size to predict alignment resources
LANE_GB = {(s, l): (os.path.getsize(SAMPLE_R1[s][int(l)]) + os.path.getsize(SAMPLE_R2[s][int(l)])) / 1e9
           for s in SAMPLES for l in SAMPLE_LANES[s]}
SAMPLE_GB = {s: sum(LANE_GB[(s, l)] for l in SAMPLE_LANES[s]) for s in SAMPLES}

def lane_rt(a, b):
    return lambda wc, attempt: attempt * math.ceil(a + b * LANE_GB[(wc.sample, wc.lane)])

